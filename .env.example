# ============================================================
# VERDICT - Configuration
# ============================================================
# Google Gemini API Key (Required for Gemma 4 model inference)
# Get your key from: https://aistudio.google.com/
# NOTE: This key is used on the server ONLY. Never expose in frontend.
GEMINI_API_KEY=

# Server Port (Default: 3001)
PORT=3001

# Primary Gemma Model (Default: gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it
